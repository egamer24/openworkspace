{
  "name": "openworkspace-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd packages/email dev",
    "dev:site": "bun run --cwd apps/landing dev",
    "build:site": "bun run --cwd apps/landing build",
    "preview:site": "bun run --cwd apps/landing preview",
    "test": "bun run --filter './packages/*' test",
    "test:unit": "bun run --filter './packages/*' test:unit",
    "test:e2e": "bun run --cwd packages/core test:e2e && bun run --cwd packages/email test:e2e && bun run test:example",
    "typecheck": "bun run --filter './packages/*' --filter './apps/*' typecheck",
    "test:example": "bun examples/notes-module/test/outside-monorepo.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "@oxlint/plugins": "1.93.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "ultracite": "8.1.1"
  },
  "packageManager": "bun@1.4.4"
}
