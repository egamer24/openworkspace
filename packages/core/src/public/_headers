/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Vite content-hashes everything under /assets/, so a file there never
# changes; index.html and sw.js keep revalidating. The Worker serves the
# manifest and the icons that follow the workspace logo, with their own caching.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
