---
import Command from "./command.astro";
---

<section class="hero wrap" aria-labelledby="title">
  <h1 id="title">
    <span class="nw">Team email and SSO,</span> hosted in your Cloudflare
    account
  </h1>
  <div class="hero-side">
    <p class="lede">
      An open-source alternative to <span class="nw">Google Workspace</span>. It
      deploys with one command and costs about $5 a month.
    </p>
    <Command id="cmd-hero" />
  </div>
</section>
