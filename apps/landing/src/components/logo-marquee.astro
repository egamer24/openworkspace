---

<div class="logos" aria-labelledby="logos-title">
  <h3 id="logos-title">
    Works with any app that supports OpenID Connect or SAML
  </h3>
  <svg class="sprite" aria-hidden="true" focusable="false">
    <defs>
      {logos.map(({ id, path }) => <symbol
        id={`logo-${id}`}
        viewBox="0 0 24 24"
      >
        <path d={path} />
      </symbol>)}
    </defs>
  </svg>
  <div class="marquee">
    <div class="marquee-track">
      <ul class="logo-set">
        {logos.map(({ id, name }) => <li>
          <svg aria-hidden="true" width="22" height="22">
            <use href={`#logo-${id}`} />
          </svg
          ><span>{name}</span>
        </li>)}
      </ul>
      <ul class="logo-set logo-set-copy" aria-hidden="true">
        {logos.map(({ id, name }) => <li>
          <svg aria-hidden="true" width="22" height="22">
            <use href={`#logo-${id}`} />
          </svg
          ><span>{name}</span>
        </li>)}
      </ul>
    </div>
  </div>
  <p class="logos-note">
    Some apps offer single sign-on only on paid plans. Names and logos belong to
    their owners.
  </p>
</div>
